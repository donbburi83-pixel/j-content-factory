{
  "entities": {
    "settings": {
      "title": "Site Settings",
      "description": "Global settings for the application",
      "type": "object",
      "properties": {
        "portfolioTitle": {
          "type": "string",
          "description": "The main title for the portfolio section"
        },
        "portfolioSubtitle": {
          "type": "string",
          "description": "The subtitle label for the portfolio section"
        },
        "contactTitle": {
          "type": "string",
          "description": "The title used in the contact section (default: J Content Factory)"
        },
        "contactDescription": {
          "type": "string",
          "description": "The description text in the contact section"
        },
        "instagramUrl": {
          "type": "string",
          "description": "Instagram profile link"
        },
        "youtubeUrl": {
          "type": "string",
          "description": "YouTube channel link"
        },
        "kakaoUrl": {
          "type": "string",
          "description": "KakaoTalk/Message profile link"
        },
        "contactEmail": {
          "type": "string",
          "description": "The contact email address"
        },
        "footerCopyright": {
          "type": "string",
          "description": "The copyright text at the very bottom"
        }
      },
      "required": ["portfolioTitle", "portfolioSubtitle", "contactTitle", "contactDescription"]
    },
    "portfolioItem": {
      "title": "Portfolio Item",
      "description": "A featured work in the portfolio",
      "type": "object",
      "properties": {
        "order": { "type": "number" },
        "label": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["order", "label", "title", "imageUrl"]
    }
  },
  "firestore": {
    "settings/global": {
      "schema": "settings",
      "description": "Global application settings"
    },
    "portfolio/{itemId}": {
      "schema": "portfolioItem",
      "description": "Collection of portfolio works"
    }
  }
}
